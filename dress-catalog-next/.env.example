# PostgreSQL connection string. For local development you can use Neon, Supabase, Railway, Docker Postgres, or Vercel Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Cloudinary credentials. Create a free Cloudinary account and copy these from the dashboard.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Simple admin protection for the Add Dress form. Change this before deployment.
ADMIN_PASSWORD="change-this-admin-password"

# Seller contact details used in WhatsApp, Email, and SMS inquiry buttons.
NEXT_PUBLIC_SELLER_PHONE="919999999999"
NEXT_PUBLIC_SELLER_EMAIL="seller@example.com"
